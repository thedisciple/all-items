<!-- Copy outside the repository; replace every C:\private path. Manual until approval. -->
<service>
  <id>AllItemsCaddy</id>
  <name>All Items HTTPS proxy</name>
  <description>Public TLS reverse proxy for the loopback application</description>
  <executable>C:\private\bin\caddy.exe</executable>
  <arguments>run --config "C:\private\Caddyfile" --envfile "C:\private\caddy.env"</arguments>
  <workingdirectory>C:\private</workingdirectory>
  <startmode>Manual</startmode>
  <serviceaccount><prompt>dialog</prompt></serviceaccount>
  <env name="XDG_DATA_HOME" value="C:\private\caddy-state"/>
  <env name="XDG_CONFIG_HOME" value="C:\private\caddy-state"/>
  <onfailure action="restart" delay="15 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <hidewindow>true</hidewindow>
  <logpath>C:\private\logs\caddy</logpath>
  <log mode="roll-by-size"><sizeThreshold>1024</sizeThreshold><keepFiles>4</keepFiles></log>
</service>
